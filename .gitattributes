# auto-normalize any added text files to LF on checkin
*	text=auto

# use Windows line endings for DOS/Windows shell scripts
*.bat	text eol=crlf
# UniMenu's licence is read with TYPE in DOS
resources/drives/y/dos/unimenu.txt	text eol=crlf
# use Unix line endings for Linux/macOS shell scripts
*.sh 	text eol=lf

# for github linguist 
*.h	linguist-language=C++
# PKZIP 1.x fixture inputs are byte-exact DOS text; never normalized
tests/files/archives/legacy/inputs/* -text
