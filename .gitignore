# override global gitignore: .claude/ is part of this project
!.claude/

# Precompiled Headers
*.gch
*.pch

# Default CMake build dir
/build

# VCPKG
vcpkg_installed

# Visual Studio / Code
.vs
.vscode
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ
.idea
*.iml

# Local History for Visual Studio Code
.history/

# Common editor temp/backup files
*~
*.swp
*.tmp
*.orig
*.rej

# macOS directory prefs
.DS_Store
DS_Store

# Profiling data
*.prof
*.profraw
*.profraw.imports
*.afdo
*.afdo.imports

# Intel optimization reports
*.optrpt

# clangd language server
.clangd
.cache
compile_commands.json

# CMake
CMakeUserPresets.json
cmake-build-*/

# External deps for symlinking for local dev
/lib

# Tests
/Testing

# VS Code CMake Tools test discovery cache
cmake_test_discovery_*.json

# AppImage build output
/dist

# Python
__pycache__
*.egg-info
resources/soundfonts/FluidR3_GM.sf2
